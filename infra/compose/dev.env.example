# Template for /opt/sbc-noc/dev.env on sbc-ubuntu (chmod 600, never commit the real file — ADR-0005).
# Generate the password with: openssl rand -hex 24   (hex keeps it URL-safe for DATABASE_URL)
POSTGRES_PASSWORD=
# Docker network that sbc-redis is on:
#   docker inspect sbc-redis --format '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}'
SBC_SHARED_NETWORK=
# Add the password if sbc-redis uses requirepass: redis://:PASSWORD@sbc-redis:6379/0
REDIS_URL=redis://sbc-redis:6379/0
# dev keys must not collide with prod (noc:) on the shared Redis
REDIS_PREFIX=noc:dev:
# Docker network that sbc-npm is on (web has no published port):
#   docker inspect sbc-npm --format '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}'
SBC_PROXY_NETWORK=
# Zabbix (M08/M12): ZABBIX_URL, ZABBIX_TOKEN_READ, ZABBIX_TOKEN_SYNC, ZABBIX_TAG_GROUPS
# UniFi controller (M06), local View Only user. Certificate: /opt/sbc-noc/certs/unifi-ca.pem
UNIFI_URL=
UNIFI_USERNAME=
UNIFI_PASSWORD=
UNIFI_SITE=
UNIFI_CA_FILE=/run/noc-certs/unifi-ca.pem
# Registry controller code: empty = ctl-unifi; udm after moving to the UDM Pro Max
UNIFI_CONTROLLER_CODE=
# SBC ASSET (M05): "Publish to web" CSV link of the NOC_LOC_Export tab only
SBC_ASSET_CSV_URL=
