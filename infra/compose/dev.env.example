# Template for /opt/sbc-noc/dev.env on sbc-ubuntu (chmod 600, never commit the real file — ADR-0005).
# Generate the password with: openssl rand -hex 24   (hex keeps it URL-safe for DATABASE_URL)
POSTGRES_PASSWORD=
# Docker network that sbc-redis is on:
#   docker inspect sbc-redis --format '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}'
SBC_SHARED_NETWORK=
# Add the password if sbc-redis uses requirepass: redis://:PASSWORD@sbc-redis:6379/0
REDIS_URL=redis://sbc-redis:6379/0
# dev keys must not collide with prod (noc:) on the shared Redis
REDIS_PREFIX=noc:dev:
WEB_PORT=5190
