# Template for /opt/sbc-noc/prod.env on sbc-ubuntu (chmod 600, never commit the real file — ADR-0005).
# Passwords: openssl rand -hex 24   (hex keeps them URL-safe inside DATABASE_URL)
# Owner/superuser of the prod database (migrations only)
POSTGRES_PASSWORD=
# Login of role noc_app used by api/worker; deploy.sh sets it on the role before migrating
NOC_APP_PASSWORD=
# Optional registry prefix for image names, e.g. git.sbc.lan/sbc/  (empty = local images only, ADR-0022)
NOC_IMAGE_PREFIX=
# Same networks as dev.env
SBC_SHARED_NETWORK=
SBC_PROXY_NETWORK=
# Network from which Loki is reachable, and its push URL
#   docker ps --format '{{.Names}}' | grep -i loki
#   docker inspect <loki-container> --format '{{range $k, $v := .NetworkSettings.Networks}}{{$k}} {{end}}'
SBC_LOKI_NETWORK=
LOKI_URL=http://loki:3100/loki/api/v1/push
# prod keys on the shared Redis (staging uses noc:dev:)
REDIS_URL=redis://:PASSWORD@sbc-redis:6379/0
REDIS_PREFIX=noc:
# Zabbix: read user noc-api-read (same as dev), prod sync token (ADR-0019, RW on network groups)
ZABBIX_URL=http://zabbix.sbc.lan/api_jsonrpc.php
ZABBIX_TOKEN_READ=
ZABBIX_TOKEN_SYNC=
# Comma-separated host groups whose hosts get NOC tags, e.g. 01-Core,02-Distribution,03-Access
ZABBIX_TAG_GROUPS=
# Controllers and SBC ASSET: same values as dev.env
UNIFI_URL=
UNIFI_USERNAME=
UNIFI_PASSWORD=
UNIFI_SITE=
UNIFI_CA_FILE=/run/noc-certs/unifi-ca.pem
UNIFI_CONTROLLER_CODE=
OMADA_URL=
OMADA_ID=
OMADA_CLIENT_ID=
OMADA_CLIENT_SECRET=
OMADA_SITE=
OMADA_CA_FILE=/run/noc-certs/omada-ca.pem
OMADA_CONTROLLER_CODE=
SBC_ASSET_CSV_URL=
# Device card buttons (M22): same as dev.env
LINK_ZABBIX_URL=
LINK_GRAFANA_URL=
LINK_GLPI_URL=
